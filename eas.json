{
  "cli": {
    "version": ">= 18.0.6",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "ios": { "image": "latest" },
      "android": { "image": "latest" }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "ios": { "image": "latest" },
      "android": { "image": "latest" }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "environment": "production",
      "ios": { "image": "latest" },
      "android": { "image": "latest" }
    }
  },
  "submit": {
    "production": {}
  }
}
